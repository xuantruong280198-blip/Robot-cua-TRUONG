{
  "schema_version": 1,
  "project": "Robot-cua-TRUONG",
  "firmware_base": {
    "repository": "https://github.com/78/xiaozhi-esp32",
    "ref": "v2.5.0"
  },
  "board": {
    "profile": "esp32-s3-cam-n16r8",
    "chip": "esp32s3",
    "flash_mb": 16,
    "psram_mb": 8,
    "camera_enabled": false
  },
  "display": {
    "type": "st7789",
    "width": 240,
    "height": 240,
    "rotation": null,
    "gpio": {
      "sclk": null,
      "mosi": null,
      "cs": null,
      "dc": null,
      "reset": null,
      "backlight": null
    },
    "enabled": false
  },
  "audio": {
    "microphone": {
      "type": "inmp441",
      "i2s": {
        "ws": null,
        "sck": null,
        "sd": null
      },
      "enabled": false
    },
    "amplifier": {
      "type": "max98357a",
      "i2s": {
        "din": null,
        "bclk": null,
        "lrclk": null
      },
      "enabled": false,
      "speaker_impedance_ohm": null
    }
  },
  "servos": {
    "pan": {
      "gpio": null,
      "min_deg": 20,
      "center_deg": 90,
      "max_deg": 160,
      "speed_deg_per_sec": 60,
      "enabled": false
    },
    "tilt": {
      "gpio": null,
      "min_deg": 35,
      "center_deg": 90,
      "max_deg": 145,
      "speed_deg_per_sec": 45,
      "enabled": false
    },
    "external_power_verified": false
  },
  "pir": {
    "type": "hc-sr501",
    "gpio": null,
    "enabled": false
  },
  "gpio_policy": {
    "allow_unassigned": true,
    "reject_duplicate_assignments": true,
    "reject_bootstrap_conflicts": true,
    "reject_flash_psram_conflicts": true,
    "reject_usb_uart_conflicts": true,
    "require_board_pinout_validation": true
  }
}
